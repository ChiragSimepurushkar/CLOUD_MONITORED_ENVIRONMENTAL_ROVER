# ═══════════════════════════════════════════
#  ROVER DIGITAL TWIN — Server Environment
#  Copy this file to .env and fill in values
# ═══════════════════════════════════════════

# --- Server ---
PORT=3000

# --- MongoDB ---
# Option 1: Local MongoDB (no auth)
MONGODB_URI=mongodb://localhost:27017/rover-twin

# Option 2: MongoDB Atlas (cloud) — uncomment and fill in
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rover-twin?retryWrites=true&w=majority

# --- API Key (optional — for future ThingSpeak integration) ---
# THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID
# THINGSPEAK_READ_KEY=YOUR_READ_KEY
# THINGSPEAK_WRITE_KEY=YOUR_WRITE_KEY

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
